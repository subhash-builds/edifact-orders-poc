<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:edifact="http://www.mulesoft.org/schema/mule/edifact"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/edifact http://www.mulesoft.org/schema/mule/edifact/current/mule-edifact.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd">

    <flow name="orders-to-edifact">
        <http:listener config-ref="HTTP_Listener_config" path="/orders/to-edifact" allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
            </http:error-response>
        </http:listener>
        <set-variable variableName="sourceFile" value="#[attributes.queryParams.file default '']"/>
        <set-variable variableName="edifactFile" value="#[(vars.sourceFile splitBy '.')[0] ++ '.edi']"/>
        <sftp:read doc:name="Read canonical file" path="#[p('sftp.jsonXmlFiles') ++ '/' ++ vars.sourceFile]" outputMimeType="text/plain" config-ref="SFTP_Config"/>
        <ee:transform doc:name="Load canonical order">
            <ee:variables>
                <ee:set-variable variableName="order"><![CDATA[%dw 2.0
output application/java
fun asList(value) = if (value is Array) value else if (value == null) [] else [value]
var body = read(payload as String, if (vars.sourceFile endsWith ".xml") "application/xml" else "application/json")
var canonicalOrder = if (body.purchaseOrder?) body.purchaseOrder else body
---
canonicalOrder ++ {
    lines: asList(canonicalOrder.lines),
    reasons: asList(canonicalOrder.reasons)
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Build EDIFACT structure">
            <ee:message>
                <ee:set-payload resource="dw/orders-to-edifact.dwl"/>
            </ee:message>
        </ee:transform>
        <edifact:write config-ref="EDIFACT_Config" doc:name="Write ORDERS"/>
        <set-variable variableName="edifactText" value="#[payload as String]"/>
        <sftp:write doc:name="Write EDI" path="#[p('sftp.outboundResults') ++ '/' ++ vars.edifactFile]" config-ref="SFTP_Config">
            <sftp:content><![CDATA[#[vars.edifactText]]]></sftp:content>
        </sftp:write>
        <set-payload value="#[vars.edifactText]"/>
        <edifact:read config-ref="EDIFACT_Config" doc:name="Read written ORDERS"/>
        <ee:transform doc:name="Round trip">
            <ee:variables>
                <ee:set-variable variableName="roundTripOrder" resource="dw/purchase-order.dwl"/>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="HTTP response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var sameLines = sizeOf(vars.order.lines) == sizeOf(vars.roundTripOrder.lines)
    and isEmpty(vars.order.lines filter (line, index) ->
        (line.itemId as String) != (vars.roundTripOrder.lines[index].itemId as String)
        or (line.quantity as Number) != (vars.roundTripOrder.lines[index].quantity as Number)
        or (line.unitPrice as Number) != (vars.roundTripOrder.lines[index].unitPrice as Number))
---
{
    sourceFile: vars.sourceFile,
    poNumber: vars.order.poNumber,
    status: vars.order.status,
    reasons: vars.order.reasons,
    edifactFile: p('sftp.outboundResults') ++ "/" ++ vars.edifactFile,
    roundTripMatched: (vars.order.poNumber as String) == (vars.roundTripOrder.poNumber as String)
        and (vars.order.currency as String) == (vars.roundTripOrder.currency as String)
        and sameLines,
    edifact: vars.edifactText
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="orders-error-handler"/>
    </flow>
</mule>
