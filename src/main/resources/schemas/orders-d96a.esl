form: EDIFACT
version: 'D96A'
structures:
- id: ORDERS
  name: Purchase order
  heading:
  - { idRef: BGM, position: '0020', usage: M }
  - { idRef: DTM, position: '0030', usage: M, count: 5 }
  - { idRef: NAD, position: '0040', usage: M, count: 5 }
  - { idRef: CUX, position: '0050', usage: M }
  detail:
  - groupId: LineItem
    position: '0100'
    usage: M
    count: 200
    items:
    - { idRef: LIN, position: '0110', usage: M }
    - { idRef: QTY, position: '0120', usage: M }
    - { idRef: PRI, position: '0130', usage: M }
